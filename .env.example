# Copy to .env and fill in real values before running against PostgreSQL.
#
# The public site runs with NO database: content is read from the typed local
# layer in src/content, and inbound forms are stored in .data/submissions.jsonl.
# Setting DATABASE_URL switches the admin panel to PostgreSQL through Prisma.

# PostgreSQL connection string, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/ptbin?schema=public"
DATABASE_URL=

# Absolute site URL used for metadata, canonical links, sitemap and schema.org.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin panel. Set a strong password before any shared or public deployment.
# AUTH_SECRET signs the session cookie; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
AUTH_SECRET=
